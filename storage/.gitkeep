* {
  box-sizing: border-box;
}

:root {
  color-scheme: dark;
  --bg: #060b17;
  --bg-soft: rgba(16, 24, 40, 0.8);
  --panel: rgba(10, 16, 28, 0.8);
  --panel-border: rgba(148, 163, 184, 0.18);
  --text: #ebf3ff;
  --muted: #9db5d6;
  --accent: #7c3aed;
  --accent-2: #22d3ee;
  --success: #34d399;
}

html, body, #root {
  margin: 0;
  min-height: 100%;
  min-height: 100vh;
  font-family: Inter, 'Segoe UI', sans-serif;
  background: radial-gradient(circle at top, #111827, var(--bg) 52%);
  color: var(--text);
}

body {
  min-height: 100vh;
}

button, input, textarea {
  font: inherit;
}

button {
  cursor: pointer;
}

.app-shell {
  position: relative;
  max-width: 1440px;
  margin: 0 auto;
  padding: 24px;
  min-height: 100vh;
}

.ambient {
  position: absolute;
  border-radius: 50%;
  filter: blur(90px);
  opacity: 0.35;
  pointer-events: none;
}

.ambient-1 {
  width: 280px;
  height: 280px;
  background: rgba(124, 58, 237, 0.55);
  top: 2%;
  left: 8%;
}

.ambient-2 {
  width: 240px;
  height: 240px;
  background: rgba(34, 211, 238, 0.45);
  right: 10%;
  top: 15%;
}

.ambient-3 {
  width: 320px;
  height: 320px;
  background: rgba(52, 211, 153, 0.25);
  bottom: 8%;
  left: 35%;
}

.topbar {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  margin-bottom: 24px;
  padding: 16px 20px;
  border: 1px solid var(--panel-border);
  background: rgba(15, 23, 42, 0.72);
  backdrop-filter: blur(12px);
  border-radius: 24px;
  box-shadow: 0 15px 40px rgba(15, 23, 42, 0.45);
}

.eyebrow {
  margin: 0 0 8px;
  color: var(--muted);
  font-size: 12px;
  letter-spacing: 0.12em;
  text-transform: uppercase;
}

.topbar h1, .chat-header h2, .panel-header h2 {
  margin: 0;
}

.upload-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 12px 18px;
  border-radius: 14px;
  background: linear-gradient(135deg, var(--accent), #3b82f6);
  color: white;
  font-weight: 700;
  cursor: pointer;
  transition: transform 0.2s ease;
}

.upload-button:hover {
  transform: translateY(-2px);
}

.upload-button input {
  display: none;
}

.layout {
  position: relative;
  z-index: 1;
  display: grid;
  grid-template-columns: minmax(280px, 360px) minmax(0, 1fr);
  gap: 24px;
}

.panel {
  border: 1px solid var(--panel-border);
  background: rgba(15, 23, 42, 0.72);
  backdrop-filter: blur(14px);
  border-radius: 24px;
  box-shadow: 0 20px 50px rgba(2, 6, 23, 0.5);
}

.files-panel {
  padding: 16px;
}

.panel-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16px;
}

.panel-header span {
  display: inline-flex;
  width: 28px;
  height: 28px;
  align-items: center;
  justify-content: center;
  border-radius: 999px;
  background: rgba(124, 58, 237, 0.2);
  color: #d7c4ff;
}

.empty-state {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 180px;
  color: var(--muted);
  border: 1px dashed var(--panel-border);
  border-radius: 16px;
}

.file-list {
  display: flex;
  flex-direction: column;
  gap: 14px;
}

.file-card {
  background: rgba(15, 23, 42, 0.72);
  border: 1px solid rgba(148, 163, 184, 0.18);
  border-radius: 18px;
  padding: 14px;
}

.file-card__meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
}

.file-card strong {
  display: block;
  margin-top: 12px;
}

.file-card small {
  display: block;
  margin-top: 4px;
  color: var(--muted);
}

.file-card p {
  color: var(--muted);
  line-height: 1.6;
  margin: 8px 0 0;
}

.file-tag {
  display: inline-flex;
  padding: 5px 8px;
  border-radius: 999px;
  background: rgba(34, 211, 238, 0.12);
  color: #8fe7ff;
  font-size: 11px;
  text-transform: uppercase;
}

.file-card button {
  border: none;
  background: rgba(239, 68, 68, 0.15);
  color: #fecaca;
  border-radius: 10px;
  padding: 6px 10px;
}

.chat-panel {
  display: flex;
  flex-direction: column;
  min-height: 720px;
  padding: 16px 18px 18px;
}

.chat-header {
  padding: 6px 4px 18px;
}

.messages {
  flex: 1;
  overflow: auto;
  padding: 8px 0 16px;
  display: flex;
  flex-direction: column;
  gap: 14px;
}

.message {
  display: flex;
}

.message.user {
  justify-content: flex-end;
}

.bubble {
  max-width: 78%;
  padding: 14px 16px;
  border-radius: 18px;
  line-height: 1.6;
  white-space: pre-wrap;
}

.message.assistant .bubble {
  background: rgba(148, 163, 184, 0.08);
  border: 1px solid rgba(148, 163, 184, 0.15);
}

.message.user .bubble {
  background: linear-gradient(135deg, rgba(124, 58, 237, 0.9), rgba(59, 130, 246, 0.86));
  box-shadow: 0 10px 25px rgba(79, 70, 229, 0.35);
}

.composer {
  display: flex;
  flex-direction: column;
  gap: 14px;
  padding-top: 12px;
  border-top: 1px solid rgba(148, 163, 184, 0.2);
}

textarea {
  width: 100%;
  resize: vertical;
  min-height: 88px;
  border-radius: 18px;
  border: 1px solid rgba(148, 163, 184, 0.2);
  padding: 14px 16px;
  background: rgba(15, 23, 42, 0.7);
  color: var(--text);
}

textarea::placeholder {
  color: var(--muted);
}

.composer button {
  align-self: flex-end;
  border: none;
  border-radius: 14px;
  background: linear-gradient(135deg, var(--success), var(--accent-2));
  color: #04111b;
  font-weight: 800;
  padding: 12px 18px;
}

.composer button:disabled {
  opacity: 0.7;
  cursor: not-allowed;
}

@media (max-width: 900px) {
  .layout {
    grid-template-columns: 1fr;
  }

  .chat-panel {
    min-height: 500px;
  }
}

@media (max-width: 560px) {
  .app-shell {
    padding: 14px;
  }

  .topbar {
    flex-direction: column;
    align-items: flex-start;
  }

  .upload-button {
    width: 100%;
  }

  .bubble {
    max-width: 92%;
  }
}
